<?xml version="1.0" encoding="utf-8"?>
<!--
  Only listens for window-state changes (which app/activity is now in front). It does not
  request the flags needed to read screen text, view hierarchies, or input events, so it
  cannot be used to capture keystrokes or on-screen content.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="200"
    android:packageNames="" />
