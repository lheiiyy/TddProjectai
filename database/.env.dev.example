# database/.env.dev.example
# Copy to a local, NEVER-committed .env.dev and fill in real values (or
# export these directly in your shell). Every script in database/scripts/
# and database/import/ reads connection details from these standard
# libpq environment variables ONLY — nothing is ever hardcoded in a
# script, dev or prod.
#
# See docs/05-environments.md for the full DEV/PROD isolation model.

# Which environment this is. Read by run_migrations.sh and
# import/run_import.js as a safety gate — both REFUSE to run against a
# database unless this is exactly "dev" (import/run_import.js has no
# "prod" mode at all).
SVMI_DB_ENV=dev

# Standard libpq connection variables.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=svmi_dev

# Use svmi_migrator (schema owner) to run migrations/import; use
# svmi_app (narrow DML-only role) to run the application itself. See
# database/scripts/create_roles.sql for what each role can do.
PGUSER=svmi_migrator
PGPASSWORD=change-me-set-via-ALTER-ROLE-never-committed

# One-time DEV bootstrap only (database/scripts/setup_dev_db.sh):
SVMI_DEV_DB=svmi_dev
