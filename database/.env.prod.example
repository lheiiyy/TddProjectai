# database/.env.prod.example
# Template only — filled in and applied by whoever eventually performs a
# real production cutover, which is explicitly OUT OF SCOPE for this
# phase (see docs/05-environments.md). No script in this repository ever
# defaults to these values or to SVMI_DB_ENV=prod; they are always
# supplied explicitly, by a human, at the moment a production migration
# is deliberately run — never in CI, never by default.
#
# run_migrations.sh additionally refuses SVMI_DB_ENV=prod unless
# SVMI_ALLOW_PROD_MIGRATION=yes-i-mean-it is ALSO set — a second,
# separate opt-in, on top of this file existing at all.

SVMI_DB_ENV=prod
SVMI_ALLOW_PROD_MIGRATION=yes-i-mean-it   # must be typed out deliberately; no shorter alias

PGHOST=__PROD_HOST_NOT_SET__
PGPORT=5432
PGDATABASE=svmi_prod
PGUSER=svmi_migrator
PGPASSWORD=__SET_OUT_OF_BAND_NEVER_COMMITTED__
PGSSLMODE=require

# There is no production import/seed step in this repository at all.
# import/run_import.js refuses to run unless SVMI_DB_ENV=dev, full stop —
# a production data migration is a future, separate, explicitly-approved
# phase (see docs/05-environments.md and this phase's own closing scope
# statement).
